# Application
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-value
DATABASE_URL=postgres://skilled:skilled@localhost:54329/skilled
ARTIFACT_ROOT=./artifacts
IMPORT_STAGING_ROOT=./tmp/imports

# GitHub App OAuth and installation access
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Local automated/demo mode. Must never be enabled in production.
DEV_AUTH_BYPASS=false

# Import limits
IMPORT_MAX_ARCHIVE_BYTES=26214400
IMPORT_MAX_FILES=2000
IMPORT_MAX_UNCOMPRESSED_BYTES=104857600
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_PATH_DEPTH=20
