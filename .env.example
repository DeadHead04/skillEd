DATABASE_URL=postgres://skilled:skilled@postgres:5432/skilled
ARTIFACT_ROOT=/data/artifacts
WORK_ROOT=/data/work
CODEX_HOME=/home/skilled/.codex
CODEX_BIN=codex
SKILL_UP_BIN=skill-up
SKILLED_ADMIN_LOGIN_ID=admin
SKILLED_ADMIN_DISPLAY_NAME=Local administrator
SKILLED_ADMIN_PASSWORD=replace-with-a-local-password
SKILLED_SESSION_SECRET=replace-with-at-least-32-random-characters
SKILLED_ADAPTER_MODE=real
NEXT_PUBLIC_APP_NAME=SkillEd
# CODEX_AUTH_FILE=/absolute/path/to/a/dedicated/codex/auth.json

# Real execution is gated. A login alone does not enable it.
# For a measured report from this exact image, use compose.execution.yaml:
# COMPOSE_FILE=docker-compose.yml:compose.execution.yaml
# SKILLED_IMAGE_REVISION=<full-built-git-revision>
# SKILLED_EXECUTION_REPORT_FILE=/absolute/path/to/acceptance.json
# For a direct Node executor, set the report path visible to that process:
# SKILLED_EXECUTION_EVIDENCE=/absolute/path/to/acceptance.json
