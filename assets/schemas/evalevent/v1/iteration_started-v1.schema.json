{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skilled:evalevent:v1:iteration_started-v1",
  "title": "iteration_started event v1",
  "allOf": [
    { "$ref": "urn:skilled:evalevent:v1:envelope" },
    {
      "type": "object",
      "properties": {
        "protocol_version": { "const": 1 },
        "event_version": { "const": 1 },
        "event": { "const": "iteration_started" },
        "payload": {
          "type": "object",
          "required": ["iteration"],
          "properties": {
            "iteration": { "$ref": "urn:skilled:evalevent:v1:envelope#/$defs/positiveInteger" }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
